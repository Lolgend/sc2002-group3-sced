class Main {
    + {static} main(args: String[]): void
}

class ConsoleUI <<boundary>> {
    - scanner: Scanner {readOnly}
    - out: PrintStream {readOnly}
    --
    + {static} formatMoney(cents: int): String
    + displayStartOfTurn(turn: int,\n    restaurant: Restaurant): void
    + promptMenuChoice(promptTitle: String,\n    options: List<String>): int
    - describeHappyHour(happyHour: HappyHour): String
    + displayHappyHourActivated(happyHour: HappyHour): void
    + displayHappyHourRecovery(customer: Customer, points: int): void
    + displayArrival(customer: Customer, turn: int): void
    + displayHostAction(description: String): void
    + displayWaiterAction(description: String): void
    + displayOrderTaken(order: Order): void
    + displayChefAction(description: String): void
    + displayOrderCooked(order: Order): void
    + displayPaymentCollected(order: Order): void
    + displayEatingFinished(customer: Customer,\n    table: Table): void
    + displayAbandonment(customer: Customer): void
    + displayTurnSummary(turn: int,\n    restaurant: Restaurant): void
    + displayFinalResult(result: GameResult): void
}

class GameController <<control>> {
    - restaurant: Restaurant {readOnly}
    - ui: ConsoleUI {readOnly}
    --
    + runGame(): void
    + evaluateGameResult(): GameResult
    + runTurn(turn: int): void
    - executeStep1Arrivals(turn: int): void
    - executeHappyHourStart(): void
    - executeStep2And3StaffActions(turn: int): void
    + buildLegalHostActions(): List<HostAction>
    - executeHostAction(action: HostAction): void
    + buildLegalWaiterActions(): List<WaiterAction>
    - getLowestNumberedFreeTable(): Table
    - executeWaiterAction(action: WaiterAction,\n    turn: int): void
    + buildLegalChefActions(): List<ChefAction>
    - executeChefAction(action: ChefAction): void
    - executeStep4EatingAndPayment(turn: int): void
    - executeStep5WaitingAndAbandonment(): void
    - executeStep6EndSummary(turn: int): void
}

enum WaiterActionType <<enumeration>> {
    WAIT
    SEAT_CUSTOMER
    TAKE_ORDER
    SERVE_ORDER
}

class WaiterAction {
    - type: WaiterActionType {readOnly}
    - description: String {readOnly}
    - customer: Customer [0..1] {readOnly}
    - table: Table [0..1] {readOnly}
    - order: Order [0..1] {readOnly}
    --
    + {static} createWait(): WaiterAction
    + {static} createSeat(customer: Customer,\n    table: Table): WaiterAction
    + {static} createTakeOrder(customer: Customer,\n    table: Table): WaiterAction
    + {static} createServeOrder(order: Order): WaiterAction
}

class HostAction {
    - wait: boolean {readOnly}
    - description: String {readOnly}
    - customer: Customer [0..1] {readOnly}
    - table: Table [0..1] {readOnly}
    --
    + {static} createWait(): HostAction
    + {static} createSeat(customer: Customer,\n    table: Table): HostAction
}

class ChefAction {
    - wait: boolean {readOnly}
    - description: String {readOnly}
    - order: Order [0..1] {readOnly}
    --
    + {static} createWait(): ChefAction
    + {static} createCook(order: Order): ChefAction
}

abstract class Staff <<entity>> {
    - name: String {readOnly}
    - actedThisTurn: boolean
    --
    + resetTurnState(): void
    # markActed(): void
}

class Waiter <<entity>> {
    + seatCustomer(customer: Customer, table: Table,\n    queue: WaitingQueue): void
    + takeOrder(orderId: int, customer: Customer,\n    table: Table, menu: Menu, random: Random,\n    happyHour: HappyHour): Order
    + serveOrder(order: Order, turn: int): void
    + waitTurn(): void
}

class Host <<entity>> {
    + seatCustomer(customer: Customer, table: Table,\n    queue: WaitingQueue): void
    + waitTurn(): void
}

class Chef <<entity>> {
    + prepareOrder(order: Order): void
    + waitTurn(): void
}

class Cashier <<entity>> {
    + processOldestReadyPayment(\n    tables: List<Table>): Order
}

class Restaurant <<entity>> {
    - config: GameConfig {readOnly}
    - waitingQueue: WaitingQueue {readOnly}
    - tables: List<Table> {readOnly}
    - menu: Menu {readOnly}
    - orders: List<Order> {readOnly}
    - waiter: Waiter {readOnly}
    - chef: Chef {readOnly}
    - cashier: Cashier {readOnly}
    - host: Host {readOnly}
    - happyHour: HappyHour {readOnly}
    - random: Random {readOnly}
    - nextCustomerId: int
    - nextOrderId: int
    - nextReadyToPaySeq: int
    - revenueCents: int
    - paidCustomersCount: int
    - totalPaidSatisfaction: int
    - abandonedCustomersCount: int
    --
    + getOrders(): List<Order>
    + getHost(): Host
    + getHappyHour(): HappyHour
    + getServedCustomersCount(): int
    + getAveragePaidSatisfaction(): double
    + getAveragePaidSatisfactionString(): String
    + allocateNextOrderId(): int
    + allocateNextReadyToPaySequence(): int
    + recordOrder(order: Order): void
    + recordPayment(order: Order): void
    + processArrival(turn: int): Customer
    # createCustomer(id: int, turn: int): Customer
    + processEatingCompletions(turn: int): List<Table>
    + processHappyHourRecovery(): List<Customer>
    + processTurnEndDecayAndAbandonment(): List<Customer>
    + isVictory(): boolean
}

class GameConfig {
    + {static} DEFAULT_MAX_TURNS: int = 18 {readOnly}
    + {static} DEFAULT_NUM_TABLES: int = 2 {readOnly}
    - {static} DEFAULT_ARRIVAL_TURNS: int[]\n    = {1, 4, 7, 10, 13, 16} {readOnly}
    + {static} DEFAULT_TARGET_PAID_CUSTOMERS: int = 4 {readOnly}
    + {static} DEFAULT_TARGET_REVENUE_CENTS: int = 4500 {readOnly}
    + {static} DEFAULT_TARGET_AVG_SATISFACTION: double = 60.0 {readOnly}
    + {static} DEFAULT_SEED: long = 42L {readOnly}
    - maxTurns: int {readOnly}
    - numTables: int {readOnly}
    - arrivalTurns: int[] {readOnly}
    - targetPaidCustomers: int {readOnly}
    - targetRevenueCents: int {readOnly}
    - targetAvgSatisfaction: double {readOnly}
    - seed: long {readOnly}
    --
    + {static} createBaseConfig(): GameConfig
    + getArrivalTurns(): int[]
    + isArrivalTurn(turn: int): boolean
    + isPaidTargetMet(paidCount: int): boolean
    + isRevenueTargetMet(revenueCents: int): boolean
    + isSatisfactionTargetMet(avgSatisfaction: double): boolean
    + isVictory(paidCount: int, revenueCents: int,\n    avgSatisfaction: double): boolean
}

class GameResult <<record>> {
    - isVictory: boolean {readOnly}
    - paidCustomersCount: int {readOnly}
    - targetPaidCustomers: int {readOnly}
    - paidCustomersTargetMet: boolean {readOnly}
    - revenueCents: int {readOnly}
    - targetRevenueCents: int {readOnly}
    - revenueTargetMet: boolean {readOnly}
    - averagePaidSatisfaction: double {readOnly}
    - targetAverageSatisfaction: double {readOnly}
    - satisfactionTargetMet: boolean {readOnly}
    - abandonedCustomersCount: int {readOnly}
    --
    + getAveragePaidSatisfactionString(): String
}

class WaitingQueue <<entity>> {
    - customers: List<Customer> {readOnly}
    --
    + addCustomer(customer: Customer): void
    + removeCustomer(customer: Customer): boolean
    + getCustomers(): List<Customer>
    + isEmpty(): boolean
    + size(): int
}

class Table <<entity>> {
    - tableNumber: int {readOnly}
    - currentCustomer: Customer [0..1]
    - currentOrder: Order [0..1]
    --
    + isFree(): boolean
    + seatCustomer(customer: Customer): void
    + assignOrder(order: Order): void
    + freeTable(): void
}

abstract class Customer <<entity>> {
    - id: int {readOnly}
    - arrivalTurn: int {readOnly}
    - satisfaction: int
    - state: CustomerState
    - satisfactionAtPayment: Integer [0..1]
    - servedTurn: int
    - readyToPaySequence: int
    --
    + {abstract} getCustomerType(): String
    + {abstract} getWaitingSatisfactionLoss(): int
    + chooseMenuItem(menu: Menu, random: Random): MenuItem
    + calculateBillCents(item: MenuItem): int
    + hasFinishedEating(currentTurn: int): boolean
    + isWaitingForService(): boolean
    + recoverSatisfaction(points: int): boolean
    + applyTurnEndSatisfactionDecay(): boolean
    + markSeated(): void
    + markOrderPlaced(): void
    + markServed(turn: int): void
    + markReadyToPay(sequenceNumber: int): void
    + markPaid(): void
}

class RegularCustomer <<entity>> {
    + getCustomerType(): String
    + getWaitingSatisfactionLoss(): int
}

class VIPCustomer <<entity>> {
    + getCustomerType(): String
    + getWaitingSatisfactionLoss(): int
    + calculateBillCents(item: MenuItem): int
}

class CriticCustomer <<entity>> {
    + getCustomerType(): String
    + getWaitingSatisfactionLoss(): int
    + chooseMenuItem(menu: Menu, random: Random): MenuItem
}

enum CustomerState <<enumeration>> {
    WAITING_IN_QUEUE
    SEATED
    WAITING_FOR_FOOD
    EATING
    READY_TO_PAY
    PAID
    ABANDONED
}

class Order <<entity>> {
    - id: int {readOnly}
    - customer: Customer {readOnly}
    - table: Table {readOnly}
    - menuItem: MenuItem {readOnly}
    - finalPriceCents: int {readOnly}
    - totalPrepUnits: int {readOnly}
    - completedPrepUnits: int
    - status: OrderStatus
    --
    + advancePreparation(): void
    + markServed(): void
    + markPaid(): void
    + markCancelled(): void
}

enum OrderStatus <<enumeration>> {
    IN_PROGRESS
    READY
    SERVED
    PAID
    CANCELLED
}

class Menu <<entity>> {
    - items: List<MenuItem> {readOnly}
    --
    + {static} createBaseMenu(): Menu
}

interface MenuItem <<interface>> {
    + getName(): String
    + getPriceCents(): int
    + getPrepUnits(): int
}

class ComboMeal <<entity>> {
    - firstItem: MenuItem {readOnly}
    - secondItem: MenuItem {readOnly}
    --
    + getName(): String
    + getPriceCents(): int
    + getPrepUnits(): int
}

class HappyHour <<entity>> {
    - {static} DURATION_TURNS: int = 2 {readOnly}
    - {static} DISCOUNT_MULTIPLIER: double = 0.8 {readOnly}
    - {static} SATISFACTION_RECOVERY: int = 15 {readOnly}
    - used: boolean
    - remainingTurns: int
    --
    + isAvailable(): boolean
    + isActive(): boolean
    + getRemainingTurns(): int
    + getSatisfactionRecovery(): int
    + activate(): void
    + endTurn(): void
    + applyDiscount(priceCents: int): int
}

class Dish <<entity>> {
    - name: String {readOnly}
    - priceCents: int {readOnly}
    - prepUnits: int {readOnly}
}

