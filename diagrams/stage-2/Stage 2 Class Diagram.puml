@startuml Stage_2_Class_Diagram

' Stage 2 = Stage 1 + VIPCustomer / CriticCustomer (and calculateBillCents).
' All Stage 1 relationships are retained unchanged (same types, labels, multiplicities).
title Restaurant Rush - Stage 2 Class Diagram

skinparam classAttributeIconSize 0
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 6
skinparam nodesep 170
skinparam ranksep 120
skinparam defaultFontSize 20
skinparam Padding 8
skinparam ArrowFontSize 17
skinparam titleFontSize 36
skinparam ArrowThickness 1
skinparam groupInheritance 1
skinparam class {
    BackgroundColor #ECECEC
    HeaderBackgroundColor #ECECEC
    BorderColor #555555
    ArrowColor #222222
    BackgroundColor<<boundary>> #DCEBFA
    HeaderBackgroundColor<<boundary>> #DCEBFA
    BorderColor<<boundary>> #1F5FA8
    BackgroundColor<<control>> #FDE5C8
    HeaderBackgroundColor<<control>> #FDE5C8
    BorderColor<<control>> #B35C00
    BackgroundColor<<entity>> #DDF2DD
    HeaderBackgroundColor<<entity>> #DDF2DD
    BorderColor<<entity>> #2E7D32
    BackgroundColor<<enumeration>> #EADCF5
    HeaderBackgroundColor<<enumeration>> #EADCF5
    BorderColor<<enumeration>> #6A2C9A
    BackgroundColor<<interface>> #D3F0EE
    HeaderBackgroundColor<<interface>> #D3F0EE
    BorderColor<<interface>> #00796B
    BackgroundColor<<record>> #ECECEC
    HeaderBackgroundColor<<record>> #ECECEC
    BorderColor<<record>> #555555
}

skinparam legend {
    BackgroundColor #FFFFFF
    BorderColor #333333
}
hide empty members
hide circle

' ============================================================================
' CLASSES
' ============================================================================

class Main {
    + {static} main(args: String[]): void
}

class ConsoleUI <<boundary>> {
    - scanner: Scanner {final}
    - out: PrintStream {final}
    --
    + {static} formatMoney(cents: int): String
    + displayStartOfTurn(turn: int,\n    restaurant: Restaurant): void
    + promptMenuChoice(promptTitle: String,\n    options: List<String>): int
    + displayArrival(customer: Customer, turn: int): void
    + displayWaiterAction(description: String): void
    + displayOrderTaken(order: Order): void
    + displayChefAction(description: String): void
    + displayOrderCooked(order: Order): void
    + displayPaymentCollected(order: Order): void
    + displayEatingFinished(customer: Customer,\n    table: Table): void
    + displayAbandonment(customer: Customer): void
    + displayTurnSummary(turn: int,\n    restaurant: Restaurant): void
    + displayFinalResult(result: GameResult): void
}

class GameController <<control>> {
    - restaurant: Restaurant {final}
    - ui: ConsoleUI {final}
    --
    + runGame(): void
    + evaluateGameResult(): GameResult
    + runTurn(turn: int): void
    - executeStep1Arrivals(turn: int): void
    - executeStep2And3StaffActions(turn: int): void
    + buildLegalWaiterActions(): List<WaiterAction>
    - getLowestNumberedFreeTable(): Table
    - executeWaiterAction(action: WaiterAction,\n    turn: int): void
    + buildLegalChefActions(): List<ChefAction>
    - executeChefAction(action: ChefAction): void
    - executeStep4EatingAndPayment(turn: int): void
    - executeStep5WaitingAndAbandonment(): void
    - executeStep6EndSummary(turn: int): void
}

enum WaiterActionType <<enumeration>> {
    WAIT
    SEAT_CUSTOMER
    TAKE_ORDER
    SERVE_ORDER
}

class WaiterAction {
    - type: WaiterActionType {final}
    - description: String {final}
    - customer: Customer [0..1] {final}
    - table: Table [0..1] {final}
    - order: Order [0..1] {final}
    --
    + {static} createWait(): WaiterAction
    + {static} createSeat(customer: Customer,\n    table: Table): WaiterAction
    + {static} createTakeOrder(customer: Customer,\n    table: Table): WaiterAction
    + {static} createServeOrder(order: Order): WaiterAction
}

class ChefAction {
    - wait: boolean {final}
    - description: String {final}
    - order: Order [0..1] {final}
    --
    + {static} createWait(): ChefAction
    + {static} createCook(order: Order): ChefAction
}

abstract class Staff <<entity>> {
    - name: String {final}
    - actedThisTurn: boolean
    --
    + resetTurnState(): void
    # markActed(): void
}

class Waiter <<entity>> {
    + seatCustomer(customer: Customer, table: Table,\n    queue: WaitingQueue): void
    + takeOrder(orderId: int, customer: Customer,\n    table: Table, menu: Menu, random: Random): Order
    + serveOrder(order: Order, turn: int): void
    + waitTurn(): void
}

class Chef <<entity>> {
    + prepareOrder(order: Order): void
    + waitTurn(): void
}

class Cashier <<entity>> {
    + processOldestReadyPayment(\n    tables: List<Table>): Order
}

class Restaurant <<entity>> {
    - config: GameConfig {final}
    - waitingQueue: WaitingQueue {final}
    - tables: List<Table> {final}
    - menu: Menu {final}
    - orders: List<Order> {final}
    - waiter: Waiter {final}
    - chef: Chef {final}
    - cashier: Cashier {final}
    - random: Random {final}
    - nextCustomerId: int
    - nextOrderId: int
    - nextReadyToPaySeq: int
    - revenueCents: int
    - paidCustomersCount: int
    - totalPaidSatisfaction: int
    - abandonedCustomersCount: int
    --
    + getOrders(): List<Order>
    + getServedCustomersCount(): int
    + getAveragePaidSatisfaction(): double
    + getAveragePaidSatisfactionString(): String
    + allocateNextOrderId(): int
    + allocateNextReadyToPaySequence(): int
    + recordOrder(order: Order): void
    + recordPayment(order: Order): void
    + processArrival(turn: int): Customer
    # createCustomer(id: int, turn: int): Customer
    + processEatingCompletions(turn: int): List<Table>
    + processTurnEndDecayAndAbandonment(): List<Customer>
    + isVictory(): boolean
}

class GameConfig {
    + {static} DEFAULT_MAX_TURNS: int = 18 {final}
    + {static} DEFAULT_NUM_TABLES: int = 2 {final}
    - {static} DEFAULT_ARRIVAL_TURNS: int[]\n    = {1, 4, 7, 10, 13, 16} {final}
    + {static} DEFAULT_TARGET_PAID_CUSTOMERS: int = 4 {final}
    + {static} DEFAULT_TARGET_REVENUE_CENTS: int = 4500 {final}
    + {static} DEFAULT_TARGET_AVG_SATISFACTION: double = 60.0 {final}
    + {static} DEFAULT_SEED: long = 42L {final}
    - maxTurns: int {final}
    - numTables: int {final}
    - arrivalTurns: int[] {final}
    - targetPaidCustomers: int {final}
    - targetRevenueCents: int {final}
    - targetAvgSatisfaction: double {final}
    - seed: long {final}
    --
    + {static} createBaseConfig(): GameConfig
    + getArrivalTurns(): int[]
    + isArrivalTurn(turn: int): boolean
    + isPaidTargetMet(paidCount: int): boolean
    + isRevenueTargetMet(revenueCents: int): boolean
    + isSatisfactionTargetMet(avgSatisfaction: double): boolean
    + isVictory(paidCount: int, revenueCents: int,\n    avgSatisfaction: double): boolean
}

class GameResult <<record>> {
    - isVictory: boolean {final}
    - paidCustomersCount: int {final}
    - targetPaidCustomers: int {final}
    - paidCustomersTargetMet: boolean {final}
    - revenueCents: int {final}
    - targetRevenueCents: int {final}
    - revenueTargetMet: boolean {final}
    - averagePaidSatisfaction: double {final}
    - targetAverageSatisfaction: double {final}
    - satisfactionTargetMet: boolean {final}
    - abandonedCustomersCount: int {final}
    --
    + GameResult(isVictory: boolean, paidCustomersCount: int,\n    targetPaidCustomers: int,\n    paidCustomersTargetMet: boolean, revenueCents: int,\n    targetRevenueCents: int, revenueTargetMet: boolean,\n    averagePaidSatisfaction: double,\n    targetAverageSatisfaction: double,\n    satisfactionTargetMet: boolean,\n    abandonedCustomersCount: int)
    + isVictory(): boolean
    + paidCustomersCount(): int
    + targetPaidCustomers(): int
    + paidCustomersTargetMet(): boolean
    + revenueCents(): int
    + targetRevenueCents(): int
    + revenueTargetMet(): boolean
    + averagePaidSatisfaction(): double
    + targetAverageSatisfaction(): double
    + satisfactionTargetMet(): boolean
    + abandonedCustomersCount(): int
    + getAveragePaidSatisfactionString(): String
}

class WaitingQueue <<entity>> {
    - customers: List<Customer> {final}
    --
    + addCustomer(customer: Customer): void
    + removeCustomer(customer: Customer): boolean
    + getCustomers(): List<Customer>
    + isEmpty(): boolean
    + size(): int
}

class Table <<entity>> {
    - tableNumber: int {final}
    - currentCustomer: Customer [0..1]
    - currentOrder: Order [0..1]
    --
    + isFree(): boolean
    + seatCustomer(customer: Customer): void
    + assignOrder(order: Order): void
    + freeTable(): void
}

abstract class Customer <<entity>> {
    - id: int {final}
    - arrivalTurn: int {final}
    - satisfaction: int
    - state: CustomerState
    - satisfactionAtPayment: Integer [0..1]
    - servedTurn: int
    - readyToPaySequence: int
    --
    + {abstract} getCustomerType(): String
    + {abstract} getWaitingSatisfactionLoss(): int
    + chooseMenuItem(menu: Menu, random: Random): MenuItem
    + calculateBillCents(item: MenuItem): int
    + hasFinishedEating(currentTurn: int): boolean
    + isWaitingForService(): boolean
    + applyTurnEndSatisfactionDecay(): boolean
    + markSeated(): void
    + markOrderPlaced(): void
    + markServed(turn: int): void
    + markReadyToPay(sequenceNumber: int): void
    + markPaid(): void
}

class RegularCustomer <<entity>> {
    + getCustomerType(): String
    + getWaitingSatisfactionLoss(): int
}

class VIPCustomer <<entity>> {
    + getCustomerType(): String
    + getWaitingSatisfactionLoss(): int
    + calculateBillCents(item: MenuItem): int
}

class CriticCustomer <<entity>> {
    + getCustomerType(): String
    + getWaitingSatisfactionLoss(): int
    + chooseMenuItem(menu: Menu, random: Random): MenuItem
}

enum CustomerState <<enumeration>> {
    WAITING_IN_QUEUE
    SEATED
    WAITING_FOR_FOOD
    EATING
    READY_TO_PAY
    PAID
    ABANDONED
}

class Order <<entity>> {
    - id: int {final}
    - customer: Customer {final}
    - table: Table {final}
    - menuItem: MenuItem {final}
    - finalPriceCents: int {final}
    - totalPrepUnits: int {final}
    - completedPrepUnits: int
    - status: OrderStatus
    --
    + advancePreparation(): void
    + markServed(): void
    + markPaid(): void
    + markCancelled(): void
}

enum OrderStatus <<enumeration>> {
    IN_PROGRESS
    READY
    SERVED
    PAID
    CANCELLED
}

class Menu <<entity>> {
    - items: List<MenuItem> {final}
    --
    + {static} createBaseMenu(): Menu
}

interface MenuItem <<interface>> {
    + getName(): String
    + getPriceCents(): int
    + getPrepUnits(): int
}

class Dish <<entity>> {
    - name: String {final}
    - priceCents: int {final}
    - prepUnits: int {final}
    --
    + Dish(name: String, priceCents: int, prepUnits: int)
}

' ============================================================================
' RELATIONSHIPS
' ============================================================================

' --- Bootstrap
Main ..> ConsoleUI : instantiates >
Main ..> GameController : instantiates & runs >
Main ..> Restaurant : instantiates >

' --- Control
GameController "0..*" --> "1" ConsoleUI : ui >
GameController "0..*" --> "1" Restaurant : restaurant >
GameController ..> WaiterAction : builds & executes >
GameController ..> ChefAction : builds & executes >
GameController ..> GameResult : evaluates >
ConsoleUI ..> GameResult : renders >
WaiterAction "0..*" --> "1" WaiterActionType : type >
WaiterAction ..> Customer
WaiterAction ..> Table
WaiterAction ..> Order
ChefAction ..> Order

' --- Restaurant composition
Restaurant "1" *-- "1" GameConfig : config >
Restaurant "1" *-- "1" WaitingQueue : waitingQueue >
Restaurant "1" *-- "1..*" Table : tables >
Restaurant "1" *-- "1" Menu : menu >
Restaurant "1" *-- "0..*" Order : orders >
Restaurant "1" *-- "1" Waiter : waiter >
Restaurant "1" *-- "1" Chef : chef >
Restaurant "1" *-- "1" Cashier : cashier >

' --- Staff
Staff <|-- Waiter
Staff <|-- Chef
Staff <|-- Cashier
Waiter ..> WaitingQueue
Waiter ..> Table
Waiter ..> Menu
Waiter ..> Order
Chef ..> Order
Cashier ..> Table
Cashier ..> Order

' --- Domain
WaitingQueue "0..1" o-- "0..*" Customer : customers >
Table "0..1" o-- "0..1" Customer : currentCustomer >
Table "0..1" o-- "0..1" Order : currentOrder >
Order "0..1" --> "1" Customer : customer >
Order "0..*" --> "1" Table : table >
Order "0..*" --> "1" MenuItem : menuItem >
Order "0..*" --> "1" OrderStatus : status >
Menu "1" *-- "1..*" MenuItem : items >
Customer "0..*" --> "1" CustomerState : state >
Customer <|-- RegularCustomer
' Stage 2 additions
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
MenuItem <|.. Dish


note top of Order
  <b>Encapsulation of State & Pricing:</b>
  • Private mutable fields (<i>status</i>, <i>completedPrepUnits</i>)
    can only transition via guarded domain methods:
    <i>advancePreparation()</i>, <i>markServed()</i>,
    <i>markPaid()</i>, and <i>markCancelled()</i>.
  • <i>finalPriceCents</i> is immutable and locked at order creation.
end note

note bottom of Customer
  <b>Polymorphism & Template Method Seam:</b>
  • <i>applyTurnEndSatisfactionDecay()</i> deducts
    <i>getWaitingSatisfactionLoss()</i> polymorphically
    without type checks in <i>GameController</i> or <i>Restaurant</i>.
  • <i>chooseMenuItem()</i> provides an overridable hook
    for customer-specific ordering preferences.
  • VIP: waiting loss 5; <i>calculateBillCents()</i> applies 10% off.
  • Critic: waiting loss 12; cheapest item, first in menu on ties.
  • Regular: waiting loss 8; random item and full-price billing.
  • <i>Waiter.takeOrder()</i> delegates pricing to the customer;
    the calculated price is stored in <i>Order</i>.
  • Guarded transitions enforce legal <i>CustomerState</i> progression.
end note

note top of Restaurant
  <b>Composition & Aggregate Root:</b>
  • <i>Restaurant</i> owns the lifecycle of its <i>Table</i>s,
    <i>WaitingQueue</i>, <i>Menu</i>, <i>GameConfig</i>, and <i>Staff</i>.
  • <i>createCustomer()</i> creates VIP C2, Critic C5,
    and Regular customers for the other arrivals.
  • Collections (<i>tables</i>, <i>orders</i>) and <i>WaitingQueue</i>
    expose unmodifiable views to prevent external mutation.
end note

note bottom of MenuItem
  <b>Abstraction Seam (MenuItem):</b>
  • <i>Order</i> and <i>Menu</i> depend on the <i>MenuItem</i>
    interface rather than concrete <i>Dish</i>, allowing
    composite items in later stages without changing <i>Order</i>.
end note

